# Shared
NODE_ENV=development

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
PUBLIC_SITE_URL=http://localhost:3000

# Backend
PORT=4000
API_CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5432/portfolio_platform?schema=public
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
AUTH_MFA_REQUIRED_ROLES=
ADMIN_EMAIL=abel.valle.rosa@gmail.com
ADMIN_PASSWORD=ChangeMe123!
STORAGE_DIR=storage
MEDIA_STORAGE_PROVIDER=local
MEDIA_MAX_FILE_SIZE_MB=10
MEDIA_STORAGE_QUOTA_MB=250
MEDIA_ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/jpeg,image/png,image/webp
MEDIA_SIGNATURE_SCAN_ENABLED=true
ANALYTICS_IP_HASH_SALT=
ANALYTICS_STORE_USER_AGENT=true
ANALYTICS_RETENTION_DAYS=

# Optional PDF renderer. If unset, the backend uses a deterministic PDFKit fallback.
CHROME_EXECUTABLE_PATH=

# Optional CV AI adapter. If unset, CV adaptation uses the built-in rule-based fallback.
CV_AI_ADAPTER_URL=
CV_AI_ADAPTER_API_KEY=

# Optional contact webhook. If unset, contact messages are only stored in the database.
CONTACT_IP_HASH_SALT=
CONTACT_STORE_USER_AGENT=true
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=
CONTACT_WEBHOOK_RETRY_ATTEMPTS=2
CONTACT_WEBHOOK_RETRY_DELAY_MS=30000

# Optional LinkedIn integration. If unset, only public profile/share links are exposed.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:4000/api/v1/integrations/linkedin/callback
